# =========================
# WebDAV required
# =========================
WEBDAV_BASE_URL=https://webdav.example.com/webdav
WEBDAV_USERNAME=your_username
WEBDAV_PASSWORD=your_password
WEBDAV_SESSION_SECRET=replace_with_a_long_random_secret_at_least_24_chars

# Internal Edge Function -> Cloud Function directory proxy secret.
# Use a separate random value, at least 24 chars. Never expose it to the browser.
WEBDAV_INTERNAL_KEY=replace_with_a_separate_internal_secret_at_least_24_chars

# =========================
# WebDAV optional
# =========================
WEBDAV_ALLOWED_HOSTS=webdav.example.com
WEBDAV_CHUNK_BYTES=4194304
WEBDAV_MAX_UPLOAD_BYTES=8589934592
WEBDAV_TEMP_DIR=/.edgeone-upload
WEBDAV_SESSION_TTL_SECONDS=43200
DIRECTORY_CACHE_TTL_MS=15000

# =========================
# EdgeOne CDN download required
# =========================
CDN_DOWNLOAD_HOST=123cdn.example.com
CDN_AUTH_KEY=replace_with_edgeone_token_auth_method_d_key
CDN_TOKEN_VALID_SECONDS=3600

# Secret injected by EdgeOne only on CDN -> Makers origin requests.
# Use a DIFFERENT random secret from CDN_AUTH_KEY, at least 24 chars.
CDN_ORIGIN_KEY=replace_with_a_separate_random_origin_secret

# Cloud Function maximum accepted CDN origin Range.
# Default/recommended: 4 MiB. Browser native download does not assemble these ranges itself.
# EdgeOne chooses the actual origin fragment size; the server clamps the accepted maximum to <= 4 MiB.
CDN_RANGE_BYTES=4194304

# KV is a Makers binding, not a string env var.
# Bind the namespace as: WEBDAV_KV
